<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WebcamStudio.Domain\WebcamStudio.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unica dependencia externa de esta capa: solo las abstracciones de DI
         (para poder exponer AddApplication() como composition root del modulo),
         nada de EF Core, HTTP, etc. Eso se queda en Infrastructure/Api a proposito. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
